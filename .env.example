# Copy to .env and fill in. Never commit a real .env.
# See specification section 20 "Required configuration and decisions".

# PostgreSQL connection (Railway: use the private DATABASE_URL, not DATABASE_PUBLIC_URL).
DATABASE_URL=postgresql://fpl:fpl@127.0.0.1:5432/fpl

APP_URL=http://localhost:3000
AUTH_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Swiss Expert League identity
LEAGUE_SLUG=swiss-expert-league
LEAGUE_DISPLAY_NAME=Swiss Expert League
LEAGUE_SHORT_NAME=SEL
LEAGUE_VISIBILITY=unlisted
# FPL classic league ID — from fantasy.premierleague.com/leagues/<ID>/standings/c
# Swiss Expert League (2026/27 renewal): 1004960
LEAGUE_PROVIDER_ID=

APP_TIMEZONE=Europe/Zurich
SCORING_TIMEZONE=Europe/London

# Data provider mode: fixtures | manual | approved-fpl
# `fixtures` = sample data for development
# `manual` = read data/league-snapshot.json (written by npm run fetch:fpl)
FANTASY_PROVIDER_MODE=fixtures
SNAPSHOT_PATH=data/league-snapshot.json
# Automated FPL collection stays disabled until a lawful access basis is confirmed.
AUTOMATIC_SYNC_ENABLED=false

BACKUP_BUCKET=

# Disable Next.js telemetry (helps Railway Serverless sleep and keeps builds quiet).
NEXT_TELEMETRY_DISABLED=1
